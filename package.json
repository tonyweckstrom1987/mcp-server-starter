{
  "name": "mcp-server-starter",
  "version": "0.1.0",
  "description": "TypeScript-pohja MCP-palvelimille: toimiva esimerkkipalvelin, testit, CI ja julkaisutyönkulku valmiina. / A TypeScript starter template for MCP servers with tests, CI and a release workflow.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "bin": {
    "mcp-server-starter": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.4"
  }
}
